---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "السياسة التحريرية",
    url: `${site.url}/editorial-policy.html`,
    inLanguage: "ar"
  }
];
---
<BaseLayout title="السياسة التحريرية" description="كيف يُكتب محتوى طموح ويُراجع ويُحدَّث، وما لا ننشره." canonical={`${site.url}/editorial-policy.html`} schema={schema}>
  <section class="page-intro container">
    <span class="eyebrow">الثقة</span>
    <h1>السياسة التحريرية</h1>
    <p>هذه الصفحة تشرح قواعدنا في الكتابة والمراجعة والنشر، وتسري على كل صفحة على هذا الموقع.</p>
  </section>
  <section class="container static-prose">
    <h2>من يكتب</h2>
    <p>يكتب المحتوى ويُراجع داخل فريق تحرير طموح تحت اسم جماعي، لأن الموقع لا ينشر أسماء أشخاص حقيقيين كمؤلفين لمواد لم يكتبوها. لا نستخدم صورًا شخصية ولا صفحات مؤلفين وهمية.</p>
    <h2>معايير النشر</h2>
    <ul>
      <li>أن يجيب المقال عن سؤال يبحث عنه القارئ فعلًا، وأن يكون عنوانه مطابقًا لمحتواه.</li>
      <li>أن تكون العبارات والأمثلة صياغة أصلية أو شائعة الاستخدام، بلا نقل حرفي من مصادر محمية.</li>
      <li>ألا يُنشر أي رقم أو إحصاء أو اقتباس بلا مصدر يمكن الرجوع إليه.</li>
      <li>أن يُصنَّف المقال في قسم واحد واضح، مع وصف لا يتجاوز سطرين.</li>
    </ul>
    <h2>التصحيح والتحديث</h2>
    <p>عند اكتشاف خطأ نصحي، نصحّح النص ونحدّث تاريخه. وعند تغيّر معلومة جوهرية، نعدّل الفقرة المعنية داخل المسار المنشور نفسه بدل إنشاء رابط جديد، حفاظًا على الروابط المفهرسة.</p>
    <h2>الروابط والإعلانات</h2>
    <p>لا نستخدم روابط تابعة (affiliate). وإذا فُعّلت الإعلانات مستقبلًا فستكون عبر شبكة إعلانية معتمدة، مع الإفصاح في <a href="/privacy/">سياسة الخصوصية</a>، ودون أن تتداخل مع تجربة القراءة.</p>
    <h2>الملكية الفكرية</h2>
    <p>إن كنت ترى أن نصًا في الموقع يتعارض مع حقك، راسلنا عبر <a href="/contact/">اتصل بنا</a> مع الرابط وسنراجع الطلب ونزيل المحتوى عند ثبوت الحق.</p>
  </section>
</BaseLayout>
