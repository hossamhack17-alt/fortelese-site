---
import EnLayout from "../../../layouts/EnLayout.astro";
import { getCollection } from "astro:content";

const LABELS: Record<string, string> = {
  insurance: "Insurance",
  money: "Money",
  property: "Property",
  education: "Education",
};

export async function getStaticPaths() {
  const posts = await getCollection("articlesEn", ({ data }) => !data.draft);
  const slugs = [...new Set(posts.map((p) => p.data.categorySlug))];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const title = LABELS[slug] ?? slug;
const posts = (await getCollection("articlesEn", ({ data }) => !data.draft))
  .filter((p) => p.data.categorySlug === slug)
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));
---
<EnLayout title={title} description={`${title} — ${posts.length} English guides on Fortelese.`}>
  <p class="eyebrow"><a href="/en">English</a> · category</p>
  <h1>{title}</h1>
  <p class="lead">{posts.length} articles in this category.</p>
  <div class="grid" style="margin-top:1.8rem">
    {posts.map((p) => (
      <article class="card">
        <h3><a href={`/en/${p.data.path ?? p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.description}</p>
        <p class="meta">{p.data.pubDate?.toISOString().slice(0, 10)}</p>
      </article>
    ))}
  </div>
  <p style="margin-top:2rem"><a class="btn" href="/en">← All English articles</a></p>
</EnLayout>
