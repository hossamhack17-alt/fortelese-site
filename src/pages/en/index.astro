---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

import { EN_SECTIONS as SECTIONS } from "../../data/en-sections";

const posts = (await getCollection("articlesEn", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);

const groups = Object.keys(SECTIONS)
  .map((slug) => ({
    slug,
    title: SECTIONS[slug],
    posts: posts.filter((p) => (p.data.section ?? "online-mba") === slug),
  }))
  .filter((g) => g.posts.length > 0);
---
<BaseLayout
  lang="en"
  dir="ltr"
  title="English Articles"
  description="English-language guides from Fortelese: online MBA programs, career development and practical education explainers."
>
  <section class="page-intro container">
    <span class="eyebrow">English section</span>
    <h1>English Articles</h1>
    <p>{posts.length} long-form guides, organised by topic. Each page keeps its original publication date and a link to where it first appeared.</p>
    <p class="card-meta">
      {groups.map((g) => (
        <a href={`/en/sections/${g.slug}/`} style="margin-inline-end:1rem">{g.title} ({g.posts.length})</a>
      ))}
    </p>
  </section>

  {groups.map((g) => (
    <section class="container" style="margin-bottom:3rem">
      <div class="section-head"><h2>{g.title}</h2><a href={`/en/sections/${g.slug}/`}>View section →</a></div>
      <div class="article-grid">
        {g.posts.map((p) => (
          <article class="article-card">
            <h3><a href={`/en/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.description}</p>
            <p class="card-meta">
              {p.data.pubDate?.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
              {p.data.originalUrl && <> · <a href={p.data.originalUrl} rel="nofollow noopener" target="_blank">original</a></>}
            </p>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="container" style="margin-bottom:3rem">
    <p><a class="secondary-button" href="/">← Back to the Arabic site</a> <a class="secondary-button" href="/oxfam/">Oxfam archive index</a></p>
  </section>
</BaseLayout>
