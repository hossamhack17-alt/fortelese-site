---
import EnLayout from "../../../layouts/EnLayout.astro";
import { getCollection } from "astro:content";
import { EN_SECTIONS as SECTIONS, sectionSlugs } from "../../../data/en-sections";

export async function getStaticPaths() {
  return sectionSlugs.map((slug) => ({ params: { section: slug } }));
}

const { section } = Astro.params as { section: string };
const title = SECTIONS[section] ?? section;
const posts = (await getCollection("articlesEn"))
  .filter((p) => p.data.section === section)
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));
---
<EnLayout
  title={title}
  description={`${title} — ${posts.length} long-form English guides on Fortelese.`}
>
  <p class="eyebrow"><a href="/en">English</a> · section</p>
  <h1>{title}</h1>
  <p class="lead">{posts.length} articles in this section.</p>

  <div class="grid" style="margin-top:1.8rem">
    {posts.map((p) => (
      <article class="card">
        <h3><a href={`/en/${p.data.path ?? p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.description}</p>
        <p class="meta">{p.data.pubDate?.toISOString().slice(0, 10)}</p>
      </article>
    ))}
  </div>

  <p style="margin-top:2rem"><a class="btn" href="/en">← All English articles</a></p>
</EnLayout>
