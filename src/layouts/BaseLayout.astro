---
import { site } from "../data/site";
import "../styles/global.css";
import "../styles/tools.css";
import SiteTools from "../components/SiteTools.astro";
const { title = site.name, description = site.description, canonical, image, schema = [], type = "website", noindex = false } = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image ?? "/og-default.jpg", site.url).toString();

// بيانات منظمة أساسية لكل صفحة: الموقع + مربع البحث.
// تُبنى فقط من بيانات موجودة فعلًا — لا كيانات وهمية ولا تقييمات.
const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    inLanguage: "ar",
    potentialAction: {
      "@type": "SearchAction",
      target: `${site.url}/search?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  }
];
const allSchema = [...baseSchema, ...schema];
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#123d35" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/ibm-plex-sans-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-arabic-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {allSchema.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">تخطَّ إلى المحتوى</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="طموح - الرئيسية"><span class="brand-mark">ط</span><span>طموح</span></a>
        <nav aria-label="التنقل الرئيسي">
          <a href="/">الرئيسية</a>
          <a href="/categories/">التصنيفات</a>
          <a href="/about/">من نحن</a>
          <a href="/contact/">اتصل بنا</a>
        </nav>
        <SiteTools />
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div><a class="brand footer-brand" href="/">طموح</a><p>{site.description}</p></div>
        <div class="footer-links"><a href="/about/">من نحن</a><a href="/contact/">اتصل بنا</a><a href="/editorial-policy/">سياستنا التحريرية</a><a href="/privacy/">سياسة الخصوصية</a><a href="/terms/">شروط الاستخدام</a></div>
        <small>© {new Date().getFullYear()} طموح. جميع الحقوق محفوظة.</small>
      </div>
    </footer>
    <script type="speculationrules" is:inline>
      {
        "prerender": [{
          "where": { "href_matches": "/*" },
          "eagerness": "moderate"
        }]
      }
    </script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
